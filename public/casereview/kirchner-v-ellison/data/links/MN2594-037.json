_end":"","target_pin":"961","status":"verified","target_quote":"if it is consistent with the stringent standards governing the grant of Rule 59(e) and Rule 60(b) relief","line":70,"k":1,"unit_id":"MN2594-037-8-1-1-55464397","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":8,"target_pdf_page":5,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-037","src_page":"8","text":"Rule 59(e)","n":"1","kind":"rule","target_doc":"Federal Rules of Civil Procedure (Dec. 1, 2025, uscourts.gov official pamphlet)","target_page":"85","target_page_end":"","target_pin":"Rule 59(e)","status":"verified","target_quote":"A motion to alter or amend a judgment must be filed no later than 28 days after the entry of the judgment.","line":71,"k":1,"unit_id":"MN2594-037-8-1-1-94f805d3","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":8,"target_pdf_page":104,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-037","src_page":"8","text":"Rule 60(b)","n":"1","kind":"rule","target_doc":"Federal Rules of Civil Procedure (Dec. 1, 2025, uscourts.gov official pamphlet)","target_page":"85","target_page_end":"","target_pin":"Rule 60(b)","status":"verified","target_quote":"On motion and just terms, the court may relieve a party or its legal representative from a final judgment, order, or proceeding","line":72,"k":1,"unit_id":"MN2594-037-8-1-1-0762c699","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":8,"target_pdf_page":104,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-037","src_page":"8","text":"Id. at 962","n":"1","kind":"case","target_doc":"2019 - In re SuperValu, Inc., Customer Data Security Breach Litigation, 925 F.3d 955 (8th Cir.) [CA8 slip No. 18-1648, 31 May 2019]","target_page":"5","target_page_end":"","target_pin":"962","status":"verified","tar