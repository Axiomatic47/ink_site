he issues","line":76,"k":1,"unit_id":"MN2594-037-8-3-1-48f07fa9","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":8,"target_pdf_page":103,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-037","src_page":"8","text":"Bhatia v. 3M Co., 323 F. Supp. 3d 1082, 1096 (D. Minn. 2018)","n":"1","kind":"case","target_doc":"2018 - Bhatia v. 3M Co., 323 F. Supp. 3d 1082 (D. Minn.) [D. Minn. No. 16-cv-1304 (DWF-DTS) Doc. 118, Order, 1 Mar. 2018; GovInfo USCOURTS-mnd-0_16-cv-01304-0]","target_page":"16","target_page_end":"","target_pin":"1096","status":"verified","target_quote":"Plaintiffs make this request without filing a formal motion or attaching a proposed amended complaint.","line":77,"k":1,"unit_id":"MN2594-037-8-1-1-9e0c8258","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":8,"target_pdf_page":16,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-037","src_page":"8","text":"L.R. 15.1","n":"1","kind":"rule","target_doc":"MN-LR-DMinn","target_page":"40","target_page_end":"","target_pin":"LR 15.1(b)","status":"verified","target_quote":"Any motion to amend a pleading must be accompanied by: (1) a copy of the proposed amended pleading","line":78,"k":1,"unit_id":"MN2594-037-8-1-1-4a52dd2c","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":8,"target_pdf_page":63,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-037","src_page":"9","text":"A.H. v. St. Louis Cty, Missouri, 891 F.3d 721, 730 (8th Cir. 2018)","n":"1","kind":"case","target_doc":"2018 - A.H. v. St. Louis County, 891 F.3d 721 (8th Cir.) [CA8 slip Nos. 17-1198 and 17-1393, 4 Jun. 2018]","target_page":"12","target_page_end":"","target_pin":"730","status":"verified","target_quote":"Futility is always a basis to deny leave to file an amended complaint.","line":79,"k":1,"unit_