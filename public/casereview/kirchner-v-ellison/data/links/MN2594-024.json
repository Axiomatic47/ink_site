":"MN2594-024","src_page":"2","text":"Id.","n":"2","kind":"ecf","target_doc":"MN2594-020","target_page":"1","target_page_end":"","target_pin":"Doc. 20","status":"mapped","target_quote":"","line":9,"k":1,"unit_id":"MN2594-024-2-2-1-55464397","violations":[],"warnings":[],"target_ligature_drop":null,"src_pdf_page":2,"target_pdf_page":1,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-024","src_page":"2","text":"Doc. 17","n":"1","kind":"ecf","target_doc":"MN2594-017","target_page":"1","target_page_end":"","target_pin":"","status":"mapped","target_quote":"","line":10,"k":1,"unit_id":"MN2594-024-2-1-1-b060c46d","violations":[],"warnings":[],"target_ligature_drop":null,"src_pdf_page":2,"target_pdf_page":1,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-024","src_page":"2","text":"Local Rule 7.1(c)","n":"1","kind":"rule","target_doc":"MN-LR-DMinn","target_page":"23","target_page_end":"","target_pin":"LR 7.1(c)","status":"verified","target_quote":"Dispositive Motions. Unless the court orders otherwise, all dispositive motions must be heard by the district judge.","line":11,"k":1,"unit_id":"MN2594-024-2-1-1-f52edd6b","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":46,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"2","text":"L.R. 7.1(c)(3)(B)","n":"1","kind":"rule","target_doc":"MN-LR-DMinn","target_page":"24","target_page_end":"","target_pin":"LR 7.1(c)(3)(B)","status":"verified","target_quote":"A reply memorandum must not raise new grounds for relief or present matters that do not relate to the opposing party's response.","line":12,"k":1,"unit_id":"MN2594-024-2-1-1-0e692ec2","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":47,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"2","text":"Local Rule 7.1(i)","n":"1","kind":"rule","target_doc":"MN-LR-DMinn","target_page":"28","target_page_end":"","target_pin":"LR 7.1(i)","status":"verified","target_quote":"Except with the court's prior permission, a party must not file a memorandum of law except as expressly allowed under LR 7.1.","line":13,"k":1,"unit_id":"MN2594-024-2-1-1-c3f5300a","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":51,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"2","text":"Howard v. Big Lots Stores, Inc., Case No. 09-0126, 2010 WL 11618854, at *1 n.1","n":"1","kind":"case","target_doc":"","target_page":"","target_page_end":"","target_pin":"at *1 n.1","status":"unresolved","target_quote":"","line":14,"k":1,"unit_id":"MN2594-024-2-1-1-018ccb26","violations":[],"warnings":[],"target_ligature_drop":null,"src_pdf_page":2,"target_pdf_page":null,"target_pdf_page_end":null,"target_known":false,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-024","src_page":"3","text":"Doc. 23, p. 2","n":"1","kind":"ecf","target_doc":"MN2594-023","target_page":"2","target_page_end":"","target_pin":"at 2","status":"verified","target_quote":"First, the correction of Plaintiff's own pleading.","line":15,"k":1,"unit_id":"MN2594-024-3-1-1-8fa410dc","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":2,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"3","text":"Heckler v. Chaney, 470 U.S. 821, 832-33 & n. 4","n":"1","kind":"case","target_doc":"1985 - Heckler v. Chaney, 470 U.S. 821","target_page":"832","target_page_end":"833","target_pin":"832–33 & n.4","status":"verified","target_quote":"We do not have in this case a refusal by the agency to institute proceedings based solely on the belief that it lacks jurisdiction.","line":16,"k":1,"unit_id":"MN2594-024-3-1-1-9878ab77","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":12,"target_pdf_page_end":13,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"3","text":"Doc. 22-1, p. 3-4","n":"1","kind":"ecf","target_doc":"MN2594-022-01","target_page":"3","target_page_end":"4","target_pin":"at 3–4","status":"verified","target_quote":"That reserved category is this case: the February 26 letter denied the referral by disclaiming authority, not exercising discretion.","line":17,"k":1,"unit_id":"MN2594-024-3-1-1-d1f26d0e","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":3,"target_pdf_page_end":4,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"3","text":"Doc. 15, p. 21","n":"1","kind":"ecf","target_doc":"MN2594-015","target_page":"21","target_page_end":"","target_pin":"at 21","status":"verified","target_quote":"Cf. Heckler v. Chaney, 470 U.S. 821, 832–33 & n.4 (1985)","line":18,"k":1,"unit_id":"MN2594-024-3-1-1-1411566e","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":21,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"4","text":"Doc. 22-1, p. 4","n":"1","kind":"ecf","target_doc":"MN2594-022-01","target_page":"4","target_page_end":"","target_pin":"at 4","status":"verified","target_quote":"the Reply's Ex parte Young section engages none of Plaintiff's controlling authority","line":19,"k":1,"unit_id":"MN2594-024-4-1-1-52b8bb3a","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":4,"target_pdf_page":4,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"4","text":"Doc. 22-1, p. 4","n":"2","kind":"ecf","target_doc":"MN2594-022-01","target_page":"4","target_page_end":"","target_pin":"at 4","status":"verified","target_quote":"a dismissal resting on lack of standing is jurisdictional, and a jurisdictional dismissal is not an adjudication on the merits","line":20,"k":1,"unit_id":"MN2594-024-4-2-1-52b8bb3a","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":4,"target_pdf_page":4,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"4","text":"Minn. Stat. § 8.06","n":"1","kind":"statute","target_doc":"MN-Stat-ch-8","target_page":"3","target_page_end":"","target_pin":"§ 8.06","status":"verified","target_quote":"When requested by the attorney general, it shall be the duty of any county attorney of the state to appear within the county and act as attorney for any such board, commission, or officer in any court of such county.","line":21,"k":1,"unit_id":"MN2594-024-4-1-1-870c778e","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":4,"target_pdf_page":3,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"4","text":"Doc. 22-1, p. 3","n":"1","kind":"ecf","target_doc":"MN2594-022-01","target_page":"3","target_page_end":"","target_pin":"at 3","status":"verified","target_quote":"The only Section 8.06 language quoted at Doc. 15 page 20 is verbatim","line":22,"k":1,"unit_id":"MN2594-024-4-1-1-49942d25","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":4,"target_pdf_page":3,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"4","text":"Doc. 15 page 20","n":"1","kind":"ecf","target_doc":"MN2594-015","target_page":"20","target_page_end":"","target_pin":"at 20","status":"verified","target_quote":"it shall be the duty of any county attorney of the state to appear within the county and act","line":23,"k":1,"unit_id":"MN2594-024-4-1-1-8de13929","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":4,"target_pdf_page":20,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"5","text":"Doc. 1, ¶¶ 24, 39","n":"1","kind":"ecf","target_doc":"MN2594-001","target_page":"11","target_page_end":"","target_pin":"¶ 24","status":"verified","target_quote":"Section 8.06 establishes that county attorneys act \"under the direction of the attorney general,\" meaning authority flows from the AG to county attorneys — not the reverse.","line":24,"k":1,"unit_id":"MN2594-024-5-1-1-f4ee46b1","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":5,"target_pdf_page":11,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-024","src_page":"5","text":"Doc. 1, ¶¶ 24, 39","n":"1","kind":"ecf","target_doc":"MN2594-001","target_page":"18","target_page_end":"","target_pin":"¶ 39","status":"verified","target_quote":"County attorneys act \"under the direction of the attorney general\" and \"shall, when requested by the attorney general... aid and assist in the prosecution,\"","line":25,"k":2,"unit_id":"MN2594-024-5-1-2-f4ee46b1","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":5,"target_pdf_page":18,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-024","src_page":"5","text":"Doc. 15, p. 20","n":"1","kind":"ecf","target_doc":"MN2594-015","target_page":"20","target_page_end":"","target_pin":"at 20","status":"verified","target_quote":"authority flows from the Attorney General to county attorneys, not the reverse","line":26,"k":1,"unit_id":"MN2594-024-5-1-1-246a9db2","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":5,"target_pdf_page":20,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"5","text":"Minn. Stat. § 8.06","n":"1","kind":"statute","target_doc":"MN-Stat-ch-8","target_page":"3","target_page_end":"","target_pin":"§ 8.06","status":"verified","target_quote":"The attorney general shall act as the attorney for all state officers and all boards or commissions created by law in all matters pertaining to their official duties. When requested by the attorney general, it shall be the duty of any county attorney of the state to appear within the county and act as attorney for any such board, commission, or officer in any court of such county.","line":27,"k":1,"unit_id":"MN2594-024-5-1-1-870c778e","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":5,"target_pdf_page":3,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"5","text":"Doc. 15, p. 20","n":"2","kind":"ecf","target_doc":"MN2594-015","target_page":"20","target_page_end":"","target_pin":"at 20","status":"verified","target_quote":"it shall be the duty of any county attorney of the state to appear within the county and act","line":28,"k":1,"unit_id":"MN2594-024-5-2-1-246a9db2","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":5,"target_pdf_page":20,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"5","text":"Doc. 22-1, p. 3","n":"1","kind":"ecf","target_doc":"MN2594-022-01","target_page":"3","target_page_end":"","target_pin":"at 3","status":"verified","target_quote":"The only Section 8.06 language quoted at Doc. 15 page 20 is verbatim","line":29,"k":1,"unit_id":"MN2594-024-5-1-1-49942d25","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":5,"target_pdf_page":3,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-024","src_page":"5","text":"Doc. 23, p. 1","n":"1","kind":"ecf","target_doc":"MN2594-023","target_page":"1","target_page_end":"","target_pin":"at 1","status":"verified","target_quote":"A surreply is appropriate where a reply raises matters the responding party had no prior opportunity to address","line":30,"k":1,"unit_id":"MN2594-024-5-1-1-8ea563cd","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":5,"target_pdf_page":1,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]}],"errors":[],"warnings":[],"coverage":[],"coverage_answered":[],"meta":{"src_doc":"MN2594-024","src_sha256":"3b00dec08944789e954c65bc1d19740d9ed8498554520409eba29ef75c13c2fd","cut":"2026-10-10T00:30:40-05:00","rows":29},"stale_render":null,"counts":{"rows":29,"mapped":5,"verified":23,"unresolved":1,"errors":0,"warnings":0,"coverage":0,"coverage_answered":0},"ok":true}