criminal matters to the county sheriff","line":19,"k":1,"unit_id":"MN2594-029-2-1-1-17605e1c","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":10,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-029","src_page":"2","text":"Complaint ¶¶ 22, 23, 26 and 78","n":"1","kind":"ecf","target_doc":"MN2594-001","target_page":"11","target_page_end":"","target_pin":"¶ 23","status":"verified","target_quote":"is substantively identical to the February 26 letter … has persisted across multiple administrations … constitutes an ongoing misrepresentation of Minnesota law to every citizen who visits the Attorney General's website","line":20,"k":2,"unit_id":"MN2594-029-2-1-2-17605e1c","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":11,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-029","src_page":"2","text":"Complaint ¶¶ 22, 23, 26 and 78","n":"1","kind":"ecf","target_doc":"MN2594-001","target_page":"12","target_page_end":"","target_pin":"¶ 26","status":"verified","target_quote":"establishes it as ongoing official policy of the Office of the Attorney General, not a one-time error","line":21,"k":3,"unit_id":"MN2594-029-2-1-3-17605e1c","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":12,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-029","src_page":"2","text":"Complaint ¶¶ 22, 23, 26 and 78","n":"1","kind":"ecf","target_doc":"MN2594-001","target_page":"38","target_page_end":"","target_pin":"¶ 78","status":"verified","target_quote":"operates as a categorical bar","line":22,"k":4,"unit_id":"MN2594-029-2-1-4-17605e1c","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":38,"target_pdf_page_end":null,"target_known":true,"target_p