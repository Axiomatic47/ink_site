{"doc_id":"MN2594-023","file":"LINKS_MN2594-023.tsv","header":["src_doc","src_page","text","n","kind","target_doc","target_page","target_page_end","target_pin","target_quote","status","by","note"],"rows":[{"src_doc":"MN2594-023","src_page":"1","text":"Local Rule 7.1","n":"1","kind":"rule","target_doc":"MN-LR-DMinn","target_page":"21","target_page_end":"","target_pin":"LR 7.1","status":"mapped","target_quote":"LR 7.1 CIVIL MOTION PRACTICE … Meet-and-Confer Requirement. Before filing a motion other than a motion for a temporary restraining order or a motion under Fed. R. Civ. P. 56, the moving party must, if possible, meet and confer with the opposing party","line":2,"k":1,"unit_id":"MN2594-023-1-1-1-3e8d910f","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":1,"target_pdf_page":44,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-023","src_page":"1","text":"LR 7.1(i)","n":"1","kind":"rule","target_doc":"MN-LR-DMinn","target_page":"28","target_page_end":"","target_pin":"LR 7.1(i)","status":"mapped","target_quote":"Except with the court's prior permission, a party must not file a memorandum of law except as expressly allowed under LR 7.1.","line":3,"k":1,"unit_id":"MN2594-023-1-1-1-3d405fc1","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":1,"target_pdf_page":51,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-023","src_page":"1","text":"Exhibit 1","n":"1","kind":"ecf","target_doc":"MN2594-022-01","target_page":"1","target_page_end":"","target_pin":"Ex. 1","status":"mapped","target_quote":"","line":4,"k":1,"unit_id":"MN2594-023-1-1-1-54eb0a85","violations":[],"warnings":[],"target_ligature_drop":null,"src_pdf_page":1,"target_pdf_page":1,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-023","src_page":"1","text":"Doc. 16 at 3–4","n":"1","kin