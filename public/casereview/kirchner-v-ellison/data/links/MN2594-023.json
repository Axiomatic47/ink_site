nd assist in the prosecution,\"","line":8,"k":2,"unit_id":"MN2594-023-2-1-2-3d4cdb96","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":18,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-023","src_page":"2","text":"Complaint ¶¶ 24, 39, and 41","n":"1","kind":"ecf","target_doc":"MN2594-001","target_page":"18","target_page_end":"","target_pin":"¶ 41","status":"mapped","target_quote":"","line":9,"k":3,"unit_id":"MN2594-023-2-1-3-3d4cdb96","violations":[],"warnings":[],"target_ligature_drop":null,"src_pdf_page":2,"target_pdf_page":18,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-023","src_page":"2","text":"Minn. Stat. § 8.06","n":"1","kind":"statute","target_doc":"MN-Stat-ch-8","target_page":"3","target_page_end":"","target_pin":"§ 8.06","status":"mapped","target_quote":"When requested by the attorney general, it shall be the duty of any county attorney of the state to appear within the county and act as attorney for any such board, commission, or officer in any court of such county.","line":10,"k":1,"unit_id":"MN2594-023-2-1-1-870c778e","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":3,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-023","src_page":"2","text":"¶ 40","n":"1","kind":"ecf","target_doc":"MN2594-001","target_page":"18","target_page_end":"","target_pin":"¶ 40","status":"mapped","target_quote":"Minnesota Statutes Section 388.051 grants county attorneys \"original jurisdiction\" over criminal matters.","line":11,"k":1,"unit_id":"MN2594-023-2-1-1-53f9fd61","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":18,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-023","src_page":"2","text":"Minn. Stat. § 388.051","n":"1","kind":"statute","target_doc":"MN-Stat-388.051","target_page":"1","target_page_end":"","target_pin":"§ 388.051","status":"mapped","target_quote":"The county attorney shall: … (3) prosecute felonies, including the drawing of indictments found by the grand jury, and, to the extent prescribed by law, gross misdemeanors, misdemeanors, petty misdemeanors, and violations of municipal ordinances, charter provisions and rules or regulations","line":12,"k":1,"unit_id":"MN2594-023-2-1-1-137e0c1b","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":1,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-023","src_page":"2","text":"¶ 36","n":"1","kind":"ecf","target_doc":"MN2594-001","target_page":"16","target_page_end":"","target_pin":"¶ 36","status":"mapped","target_quote":"for the violation of any such law","line":13,"k":1,"unit_id":"MN2594-023-2-1-1-a738cf4a","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":16,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-023","src_page":"2","text":"Section 8.31, subdivision 2","n":"1","kind":"statute","target_doc":"MN-Stat-ch-8","target_page":"8","target_page_end":"","target_pin":"§ 8.31, subd. 2","status":"mapped","target_quote":"the attorney general shall have power to investigate those violations, or suspected violations, and to take such steps as are necessary to cause the arrest and prosecution of all persons violating any of the statutes specifically mentioned in subdivision 1","line":14,"k":1,"unit_id":"MN2594-023-2-1-1-59d9028a","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":8,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-023","src_page":"2","text":"Exhibit B","n":"1","kind":"ecf","