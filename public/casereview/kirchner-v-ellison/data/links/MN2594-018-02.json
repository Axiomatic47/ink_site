":"MN-Stat-ch-8","target_page":"3","target_page_end":"","target_pin":"§ 8.06","status":"mapped","target_quote":"When requested by the attorney general, it shall be the duty of any county attorney of the state to appear within the county and act as attorney for any such board, commission, or officer in any court of such county.","line":22,"k":1,"unit_id":"MN2594-018-02-2-1-1-870c778e","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":3,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-018-02","src_page":"3","text":"Minn. Stat. § 8.31, subd. 1","n":"1","kind":"statute","target_doc":"MN-Stat-ch-8","target_page":"7","target_page_end":"8","target_pin":"§ 8.31, subd. 1","status":"mapped","target_quote":"The attorney general shall investigate violations of the law of this state respecting unfair, discriminatory, and other unlawful practices in business, commerce, or trade, and specifically, but not exclusively … the Prevention of Consumer Fraud Act (sections 325F.68 to 325F.70)","line":23,"k":1,"unit_id":"MN2594-018-02-3-1-1-a582a2f6","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":7,"target_pdf_page_end":8,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-018-02","src_page":"3","text":"Minn. Stat. § 8.31, subd. 2","n":"1","kind":"statute","target_doc":"MN-Stat-ch-8","target_page":"8","target_page_end":"","target_pin":"§ 8.31, subd. 2","status":"mapped","target_quote":"the attorney general shall have power to investigate those violations, or suspected violations, and to take such steps as are necessary to cause the arrest and prosecution of all persons violating any of the statutes specifically mentioned in subdivision 1","line":24,"k":1,"unit_id":"MN2594-018-02-3-1-1-b866ae3d","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":8,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-018-02","src_page":"3","text":"Minn. Stat. § 299C.061, subd. 4(c)","n":"1","kind":"statute","target_doc":"MN-Stat-299C.061","target_page":"2","target_page_end":"","target_pin":"§ 299C.061, subd. 4(c)","status":"mapped","target_quote":"Notwithstanding paragraph (b), this section has no effect on the authority of the attorney general to investigate and enforce violations or suspected violations of Minnesota civil or criminal law.","line":25,"k":1,"unit_id":"MN2594-018-02-3-1-1-36b2a93c","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":2,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-018-02","src_page":"3","text":"Ex. E at 39","n":"1","kind":"ecf","target_doc":"MN2594-003-01","target_page":"39","target_page_end":"","target_pin":"at 39","status":"mapped","target_quote":"When acting in a civil or criminal law enforcement capacity and permitted by applicable law or order","line":26,"k":1,"unit_id":"MN2594-018-02-3-1-1-42706bdf","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":39,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-018-02","src_page":"3","text":"Section 8.01","n":"1","kind":"statute","target_doc":"MN-Stat-ch-8","target_page":"1","target_page_end":"","target_pin":"§ 8.01","status":"mapped","target_quote":"Upon request of the county attorney, the attorney general shall appear in court in such criminal cases as the attorney general deems proper.","line":27,"k":1,"unit_id":"MN2594-018-02-3-1-1-433e0cc9","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":1,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-018-02","src_page":"3","text":"Complaint ¶ 38","n":"1","kind":"ecf","target_doc":"MN2594-001","target_page":"17","target_page_end":"","target_pin":"¶ 38","status":"mapped","target_quote":"","line":28,"k":1,"unit_id":"MN2594-018-02-3-1-1-1e4c45ab","violations":[],"warnings":[],"target_ligature_drop":null,"src_pdf_page":3,"target_pdf_page":17,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-018-02","src_page":"3","text":"Reply at 4","n":"1","kind":"ecf","target_doc":"MN2594-016","target_page":"4","target_page_end":"","target_pin":"at 4","status":"mapped","target_quote":"Doc. 1, ¶ 39; Doc 15, p. 20","line":29,"k":1,"unit_id":"MN2594-018-02-3-1-1-c16a482c","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":4,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-018-02","src_page":"3","text":"Doc. 15 page 20","n":"1","kind":"ecf","target_doc":"MN2594-015","target_page":"20","target_page_end":"","target_pin":"at 20","status":"mapped","target_quote":"it shall be the duty of any county attorney of the state to appear within the county and act","line":30,"k":1,"unit_id":"MN2594-018-02-3-1-1-8de13929","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":20,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-018-02","src_page":"3","text":"Doc. 15 at 20","n":"1","kind":"ecf","target_doc":"MN2594-015","target_page":"20","target_page_end":"","target_pin":"at 20","status":"mapped","target_quote":"it shall be the duty of any county attorney of the state to appear within the county and act","line":31,"k":1,"unit_id":"MN2594-018-02-3-1-1-c0982c7f","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":20,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-018-02","src_page":"3","text":"Heckler v. Chaney","n":"1","kind":"case","target_doc":"1985 - Heckler v. Chaney, 470 U.S. 821","target_page":"","target_page_end":"","target_pin":"","status":"mapped","target_quote":"","line":32,"k":1,"unit_id":"MN2594-018-02-3-1-1-ca827f9b","violations":[],"warnings":[],"target_ligature_drop":null,"src_pdf_page":3,"target_pdf_page":null,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"MN2594-018-02","src_page":"3","text":"Reply at 6","n":"1","kind":"ecf","target_doc":"MN2594-016","target_page":"6","target_page_end":"","target_pin":"at 6","status":"mapped","target_quote":"But that is the opposite of Heckler's holding.","line":33,"k":1,"unit_id":"MN2594-018-02-3-1-1-fc22bac7","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":6,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-018-02","src_page":"3","text":"470 U.S. 821, 832–33","n":"1","kind":"case","target_doc":"1985 - Heckler v. Chaney, 470 U.S. 821","target_page":"832","target_page_end":"833","target_pin":"832–33 & n.4","status":"mapped","target_quote":"We do not have in this case a refusal by the agency to institute proceedings based solely on the belief that it lacks jurisdiction.","line":34,"k":1,"unit_id":"MN2594-018-02-3-1-1-3d1339ad","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":3,"target_pdf_page":12,"target_pdf_page_end":13,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"MN2594-018-02","src_page":"4","text":"Doc. 15 § II.E","n":"1","kind":"ecf","target_doc":"MN2594-015","target_page":"21","target_page_end":"","target_pin":"§ II.E (at 21)","status":"mapped","target_quote":"A denial resting on a false statement of law is not an exercise of discretion; it is reviewable.","line":35,"k":1,"unit_id":"MN2594-018-02-4-1-1-cce846d8","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":4,