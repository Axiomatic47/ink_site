{
  "name": "ink_site",
  "version": "0.1.0",
  "private": true,
  "description": "kirchner.ink — Joseph Kirchner's publishing and grant-funding site (static Next.js export on Netlify)",
  "scripts": {
    "dev": "next dev",
    "validate-cv": "node scripts/validate-cv.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run readings:pull && npm run cv:check && npm run validate-cv && npm run validate-readings && npm run build:cv-pdf && npm run check:pdf && npm run typecheck && next build",
    "start": "npx serve out",
    "build:cv-pdf": "node scripts/build-cv-pdf.mjs",
    "cv:sync": "node scripts/cv-from-resume.mjs",
    "cv:check": "node scripts/cv-from-resume.mjs --check",
    "readings:pull": "node scripts/pull-reading-answers.mjs",
    "validate-readings": "node scripts/validate-readings.mjs",
    "test:console": "node scripts/test-console.mjs",
    "check:pdf": "node scripts/check-pdf-private.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.3",
    "katex": "^0.18.7",
    "lucide-react": "^1.44.0",
    "next": "^16.2.10",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
